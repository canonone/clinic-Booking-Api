# Copy to .env for local use (cp .env.example .env). Never commit real values.
# Loaded automatically on startup via dotenv; variables already set in the
# environment (e.g. on Render) take precedence over this file.

# Shared secret clients send in the `x-api-key` header.
# Generate one with: openssl rand -hex 16
API_KEY=change-me

# --- Local testing: Docker Postgres ---
# docker run -d --name clinic-booking-test-db -e POSTGRES_PASSWORD=pw -e POSTGRES_DB=clinic -p 54331:5432 postgres:16
DATABASE_URL=postgres://postgres:pw@127.0.0.1:54331/clinic

# --- Production: Neon Postgres (set in the Render dashboard, not in a file) ---
# Use the connection string from the Neon console; SSL is on by default for non-local hosts.
# DATABASE_URL=postgres://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require

# Optional: set to "disable" to turn off SSL for a non-local database without it.
# PGSSL=disable

# Set automatically by Render; defaults to 3000 locally.
# PORT=3000
